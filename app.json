{
  "expo": {
    "name": "Explora",
    "slug": "bitacora-geo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bitacorageo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jorge.bitacorageo",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app necesita usar la cámara para tomar fotos de los lugares de tu bitácora.",
        "NSPhotoLibraryUsageDescription": "Esta app necesita acceder a tu galería para subir fotos de los lugares.",
        "NSLocationWhenInUseUsageDescription": "Esta aplicación requiere acceso a tu ubicación para mostrar tu posición en el mapa y guardar las notas georeferenciadas."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.jorge.bitacorageo"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-maps",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite a la aplicación guardar tus coordenadas para la bitácora."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que la app acceda a tus fotos",
          "cameraPermission": "Permitir que la app use la cámara"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
